<mxfile host="app.diagrams.net" modified="2026-10-02T00:00:00.000Z" agent="week11-lab" version="24.0.0"><diagram id="Context W11" name="Context W11"><mxGraphModel dx="1900" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="<b style='font-size:15px'>ระบบจองพื้นที่ทำงานกลุ่มและอุปกรณ์การเรียนรู้</b><br><i style='font-size:12.5px'>[ระบบซอฟต์แวร์ · Responsive Web Application]</i><br>ค้นหาสถานะว่าง · จอง/ยกเลิก · อนุมัติ<br>Check-in QR · รับ-คืนอุปกรณ์<br>แจ้งเตือน · Audit Log<br>(SRS §2–§3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="760" y="320" width="400" height="270" as="geometry"/></mxCell><mxCell id="a1" value="<b style='font-size:15px'>ACT-01 นักศึกษา / บุคลากร</b><br><i style='font-size:12.5px'>[Core]</i>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="260" height="110" as="geometry"/></mxCell><mxCell id="a2" value="<b style='font-size:15px'>ACT-02 เจ้าหน้าที่ (Staff)</b><br><i style='font-size:12.5px'>[Core]</i>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="260" height="110" as="geometry"/></mxCell><mxCell id="a3" value="<b style='font-size:15px'>ACT-03 ผู้ดูแลระบบ (Admin)</b><br><i style='font-size:12.5px'>[Core]</i>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="260" height="110" as="geometry"/></mxCell><mxCell id="a4" value="<b style='font-size:15px'>ACT-04 อาจารย์ / ผู้บริหาร</b><br><i style='font-size:12.5px'>[Core]</i>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="260" height="110" as="geometry"/></mxCell><mxCell id="e1" value="<b style='font-size:15px'>EXT-01 ระบบยืนยันตัวตนกลางของสถาบัน</b><br><i style='font-size:12.5px'>[Core · AS-01]</i><br>โปรโตคอล/ฟิลด์ TBD → DD-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1560" y="190" width="300" height="140" as="geometry"/></mxCell><mxCell id="e2" value="<b style='font-size:15px'>EXT-02 ระบบอีเมลสถาบัน</b><br><i style='font-size:12.5px'>[TBD]</i><br>สเปก API/Credential รอ OI-02" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1560" y="500" width="300" height="140" as="geometry"/></mxCell><mxCell id="edge_a1_sys" value="→ ค้นหา · สร้าง/ยกเลิกคำขอ · QR Check-in (FR-01, FR-03)<br>← สถานะว่าง · Booking ID/QR · การแจ้งเตือน (FR-01, FR-04)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.2222;" edge="1" parent="1" source="a1" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge_a2_sys" value="→ อนุมัติ/ปฏิเสธคำขอ · บันทึกรับ-คืนอุปกรณ์+สภาพ (FR-02, FR-05)<br>← คิวคำขอ Pending · รายการรับ-คืน (FR-02, FR-05)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.463;" edge="1" parent="1" source="a2" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge_a3_sys" value="→ ตั้งค่ากฎ/พารามิเตอร์ · จัดการบทบาท (BR-04, NFR-02)<br>← ผลการตั้งค่า · Audit Log (NFR-01)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.7037;" edge="1" parent="1" source="a3" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge_a4_sys" value="→ ขอดูรายงาน / Export (FR-06)<br>← Dashboard สถิติ (FR-06 · รอ OI-03)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.9259;" edge="1" parent="1" source="a4" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge_sys_e1" value="→ ขอยืนยันตัวตน/claim บทบาท (AS-01)<br>← ผลยืนยันตัวตน + บทบาท · โปรโตคอล TBD (DD-01)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.2037;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="sys" target="e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge_sys_e2" value="→ คำขอส่งอีเมลแจ้งเตือน (FR-04)<br>← ผลการส่ง · สเปก/Credential TBD (OI-02)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.8148;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="sys" target="e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>