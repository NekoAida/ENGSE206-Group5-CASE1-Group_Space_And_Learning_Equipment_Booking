<mxfile host="app.diagrams.net">
  <diagram name="Container Architecture (After CR-FX-01 &amp; CR-FX-02A)" id="hd2DCCuwr1Ef6i7BTJa6">
    <mxGraphModel dx="3365" dy="1192" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cnt-act01" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" value="&lt;b style=&#39;font-size:15px&#39;&gt;ACT-01 นักศึกษา/บุคลากร&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:11px&#39;&gt;[ผู้จองพื้นที่และยืมอุปกรณ์]&lt;/i&gt;" vertex="1">
          <mxGeometry height="58" width="280" x="-140" y="60" as="geometry" />
        </mxCell>
        <mxCell id="cnt-act02" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" value="&lt;b style=&#39;font-size:15px&#39;&gt;ACT-02 เจ้าหน้าที่ (Staff)&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:11px&#39;&gt;[หน้างาน Mobile Staff Counter]&lt;/i&gt;" vertex="1">
          <mxGeometry height="58" width="280" x="200" y="60" as="geometry" />
        </mxCell>
        <mxCell id="cnt-act03" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" value="&lt;b style=&#39;font-size:15px&#39;&gt;ACT-03 ผู้ดูแลระบบ (Admin)&lt;/b&gt;" vertex="1">
          <mxGeometry height="58" width="280" x="540" y="60" as="geometry" />
        </mxCell>
        <mxCell id="cnt-act04" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" value="&lt;b style=&#39;font-size:15px&#39;&gt;ACT-04 อาจารย์/ผู้บริหาร&lt;/b&gt;" vertex="1">
          <mxGeometry height="58" width="280" x="880" y="60" as="geometry" />
        </mxCell>
        <mxCell id="cnt-webapp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Web Application Frontend&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:12.5px&#39;&gt;[Web App · React + Tailwind CSS Responsive UI]&lt;/i&gt;&lt;br&gt;ค้นหา/จอง · Soft Lock Countdown Timer (5 นาที) · QR Check-in · UI สแกนยืม-คืนบนมือถือเจ้าหน้าที่ (CR-FX-02A)&lt;br&gt;หน้าจัดการตั้งค่ารับการแจ้งเตือน Opt-in/Opt-out (FR-13) · ซ่อน/แสดงเมนูตามสิทธิ์ RBAC (BR-06)&lt;br&gt;ทำงานในเบราว์เซอร์ผู้ใช้/สมาร์ตโฟนเจ้าหน้าที่ ไม่เก็บข้อมูลถาวร" vertex="1">
          <mxGeometry height="190" width="620" x="200" y="165" as="geometry" />
        </mxCell>
        <mxCell id="cnt-serverbox" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontSize=15;fontStyle=1;fontColor=#333333;align=left;spacingLeft=10;spacingTop=6;" value="ฝั่งเซิร์ฟเวอร์ — ทีมควบคุม (Team-controlled Cluster)" vertex="1">
          <mxGeometry height="570" width="1330" x="-40" y="405" as="geometry" />
        </mxCell>
        <mxCell id="cnt-mainapi" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Main Web API Container&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:12.5px&#39;&gt;[Server-side REST API · Node.js + Express]&lt;/i&gt;&lt;br&gt;บังคับกฎ BR-01–BR-07 ทุกคำขอ · ตรวจสิทธิ์ RBAC &amp;amp; Access Token (NFR-02)&lt;br&gt; Soft Lock Logic (300s TTL) ก่อน Confirmed ใน transaction เดียว (D1)&lt;br&gt;Publish Message Events เข้า Message Queue เมื่อเกิด State Change (CR-FX-01)&lt;br&gt;เขียน AuditLog Append-Only (NFR-01) · จัดการ User Opt-in Preferences (FR-13)" vertex="1">
          <mxGeometry height="210" width="520" x="10" y="455" as="geometry" />
        </mxCell>
        <mxCell id="cnt-redis" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Lock State Engine &amp;amp; Cache&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:12.5px&#39;&gt;[In-Memory Data Store · Redis]&lt;/i&gt;&lt;br&gt;จัดเก็บ Soft Lock State ชั่วคราวด้วย TTL 300s (5 นาที)&lt;br&gt;Distributed Pessimistic Lock ป้องกัน Race Condition การจองซ้ำซ้อน (D1, NFR-02)" vertex="1">
          <mxGeometry height="110" width="520" x="10" y="705" as="geometry" />
        </mxCell>
        <mxCell id="cnt-db" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Database Container&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:12.5px&#39;&gt;[Relational DB · PostgreSQL]&lt;/i&gt;&lt;br&gt;เก็บ GroupSpace · LearningEquipment · BookingRequest · EquipmentBorrowRecord · AuditLog&lt;br&gt; User Opt-in Settings &amp;amp; Notification Preferences (FR-13) · Notification Log Table&lt;br&gt;Single Source of Truth ของสถานะระบบ — เข้าถึงผ่าน Main API เท่านั้น" vertex="1">
          <mxGeometry height="115" width="520" x="10" y="840" as="geometry" />
        </mxCell>
        <mxCell id="cnt-queue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Message Queue Container&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:12.5px&#39;&gt;[Queue Service · Redis Pub/Sub / RabbitMQ - DR-04]&lt;/i&gt;&lt;br&gt;รับและจัดคิว Message Event (Booking_Created, Checkin_Reminder_15m, Overdue_Alert)&lt;br&gt;แยกการประมวลผลการส่งแจ้งเตือนแบบ Asynchronous ไม่ให้กระทบ Main API Response Time (NFR-02, DEC-01)" vertex="1">
          <mxGeometry height="140" width="390" x="750" y="455" as="geometry" />
        </mxCell>
        <mxCell id="cnt-worker" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Notification Worker Container&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:12.5px&#39;&gt;[Background Worker · Node.js Service - DEC-01]&lt;/i&gt;&lt;br&gt;ดึง Job จาก Message Queue, Double-Check สิทธิ์ Opt-in จาก DB (BR-07, DEC-02)&lt;br&gt;ฟอร์แมตข้อความ และ Dispatch ไปยัง External Provider (LINE Notify / Email API)&lt;br&gt;พร้อม Cron Worker สแกนเตือนล่วงหน้า 15 นาทีก่อน Check-in และติดตามอุปกรณ์Overdue (FR-14, FR-15)" vertex="1">
          <mxGeometry height="170" width="390" x="750" y="630" as="geometry" />
        </mxCell>
        <mxCell id="cnt-rules" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" value="&lt;b style=&#39;font-size:15px&#39;&gt;กติกาการเชื่อมต่อ (After CR-FX-01 &amp;amp; CR-FX-02A)&lt;/b&gt;&lt;br&gt;• กฎ Concurrency/Audit/Opt-in อยู่ฝั่ง Main API และ Worker (DEC-01, DEC-02)&lt;br&gt;• Web App ห้ามต่อ Database/Redis ตรง — ผ่าน REST API เท่านั้น&lt;br&gt;• Notification Worker ทำ Double-Check Opt-in status จาก DB ก่อนส่งออกทุกครั้ง (PDPA Compliance)&lt;br&gt;• Staff UI ออกแบบให้ Responsive บน Browser มือถือโดยใช้ API ชุดเดียวกัน (CR-FX-02A)" vertex="1">
          <mxGeometry height="130" width="390" x="750" y="820" as="geometry" />
        </mxCell>
        <mxCell id="cnt-ext01" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" value="&lt;b style=&#39;font-size:15px&#39;&gt;EXT-01 ระบบยืนยันตัวตนกลาง&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:12.5px&#39;&gt;[Core · OAuth2 / SSO - AS-01]&lt;/i&gt;&lt;br&gt;ส่งคืน User Token &amp;amp; Identity Claims" vertex="1">
          <mxGeometry height="115" width="330" x="1360" y="385" as="geometry" />
        </mxCell>
        <mxCell id="cnt-ext02" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" value="&lt;b style=&#39;font-size:15px&#39;&gt;EXT-02 External Notification Gateway&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:12.5px&#39;&gt;[Extension · LINE Notify / Email Provider API]&lt;/i&gt;&lt;br&gt;รับ Payload จาก Notification Worker เพื่อส่งข้อความแจ้งเตือนหาผู้ใช้ (CR-FX-01)" vertex="1">
          <mxGeometry height="120" width="330" x="1360" y="650" as="geometry" />
        </mxCell>
        <mxCell id="cnt-ext03" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" value="&lt;b style=&#39;font-size:15px&#39;&gt;EXT-03 ระบบอีเมลสถาบัน&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:12.5px&#39;&gt;[SMTP Service]&lt;/i&gt;&lt;br&gt;ส่งสลิปยืนยันและระบบข่าวสาร" vertex="1">
          <mxGeometry height="105" width="330" x="1360" y="830" as="geometry" />
        </mxCell>
        <mxCell id="cnt-notes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=13;fontColor=#1F2937;" value="&lt;b style=&#39;font-size:15px&#39;&gt;การปรับปรุงสถาปัตยกรรมรองรับ CR-FX-01 และ CR-FX-02A&lt;/b&gt;&lt;br&gt;เพิ่ม Message Queue Container และ Notification Worker Container ช่วยประมวลผล Async Notifications ไม่กระทบ Performance ของ Core Booking API (NFR-02, DEC-01)&lt;br&gt;พร้อมปรับปรุง Web Application ให้รองรับ Mobile-Responsive UI สำหรับ Staff Counter หน้างาน (CR-FX-02A)" vertex="1">
          <mxGeometry height="85" width="1330" x="-40" y="990" as="geometry" />
        </mxCell>
        <mxCell id="cnt-edge01" edge="1" parent="1" source="cnt-act01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.1774;entryY=0.0;" target="cnt-webapp" value="ใช้งาน [HTTPS]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnt-edge02" edge="1" parent="1" source="cnt-act02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.371;entryY=0.0;" target="cnt-webapp" value="สแกนรับ-คืนบนมือถือ [HTTPS - CR-FX-02A]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnt-edge03" edge="1" parent="1" source="cnt-act03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5645;entryY=0.0;" target="cnt-webapp" value="ใช้งาน [HTTPS]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnt-edge04" edge="1" parent="1" source="cnt-act04" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.7581;entryY=0.0;" target="cnt-webapp" value="ใช้งาน [HTTPS]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnt-edge05" edge="1" parent="1" source="cnt-webapp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1.0;entryX=0.5096;entryY=0.0;" target="cnt-mainapi" value="→ คำขอ REST/JSON ผ่าน HTTPS (Soft Lock / Confirm / Opt-in Settings / Mobile Staff Scanner)&lt;br&gt;← ผลลัพธ์/สถานะ + Notification Preferences">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnt-edge06" edge="1" parent="1" source="cnt-mainapi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" target="cnt-redis" value="→ คำขอล็อก/ตรวจสอบคีย์ Soft Lock (SET key EX 300 NX)&lt;br&gt;← ผลการถือครองคีย์ (Lock Success / Lock Failed)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnt-edge07" edge="1" parent="1" source="cnt-mainapi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1.0;entryX=0.8;entryY=0.0;" target="cnt-db" value="→ อ่าน/เขียน Confirmed Record + AuditLog + User Opt-in Settings [SQL Transaction]&lt;br&gt;← ผลลัพธ์การบันทึก">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnt-edge08" edge="1" parent="1" source="cnt-mainapi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.30;entryX=0.0;entryY=0.30;" target="cnt-queue" value="→ Publish Message Event (Booking_Created, Checkin_Reminder, Overdue_Alert) [Async Push]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnt-edge09" edge="1" parent="1" source="cnt-queue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" target="cnt-worker" value="→ Dispatch Job Queue สำหรับการแจ้งเตือน">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnt-edge10" edge="1" parent="1" source="cnt-worker" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=0.75;entryX=1.0;entryY=0.5;" target="cnt-db" value="→ Query Double-Check Opt-in Status &amp;amp; User Token (DEC-02)&lt;br&gt;← Opt-in Flag (`is_opt_in = True`)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnt-edge11" edge="1" parent="1" source="cnt-worker" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" target="cnt-ext02" value="→ HTTPS POST Payload ไปยัง External Notification Gateway (LINE/Email API)&lt;br&gt;← Result Status (200 OK / Failure)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnt-edge12" edge="1" parent="1" source="cnt-mainapi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#595959;fontSize=12;startArrow=classic;startFill=1;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.9423;exitY=0.0;entryX=0.0;entryY=0.5;" target="cnt-ext01" value="→ ยืนยันตัวตน OAuth2 / SSO (AS-01)&lt;br&gt;← ผลยืนยันตัวตน + Access Token">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="500" y="442" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
